<?xml version="1.0"?>
<package format="3">
  <name>rx200_ros2</name>
  <version>0.1.0</version>
  <description>Control supervisado RX200 e interfaz con el orquestador HRI.</description>
  <maintainer email="maintainers@example.com">Mantenedores del proyecto RX200</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>interbotix_xs_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
